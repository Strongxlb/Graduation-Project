# ------------------------------------------------------------
# Jupyter / data science scratch
# ------------------------------------------------------------
*.ipynb_checkpoints
profile_default/
ipython_config.py

# ------------------------------------------------------------
# Jupyter notebooks
# Policy: do NOT version-control .ipynb files. Notebooks carry binary
# diffs (image base64, exec counts, metadata) that pollute git history.
# Instead, commit rendered HTML exports as the reviewable artefact:
#
#   jupyter nbconvert --to html path/to/notebook.ipynb
#
# Keep notebooks locally for interactive use; share results via HTML.
# Opt-in exceptions can be added below with `!path/to/keep.ipynb`.
# ------------------------------------------------------------
*.ipynb

# Opt-in: track the solved chlorine learning exercises notebook.
!Net3/02_exercises.ipynb
!Net3/02_exercises_en.ipynb

# ------------------------------------------------------------
# macOS / Windows / Linux system files
# ------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
# Office temp / lock files (e.g. .~6.2.pptx, ~$report.docx)
~$*
.~*
Icon
Thumbs.db
ehthumbs.db
desktop.ini

# ------------------------------------------------------------
# IDE / editor
# ------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.swn
*.bak
*.orig

# ------------------------------------------------------------
# Project-specific: data
# Keep schema docs and small examples; ignore raw/private/large files.
# ------------------------------------------------------------
data/raw/
data/private/
data/external/
*.h5
*.hdf5
*.npz
*.parquet
*.feather

# ------------------------------------------------------------
# Project-specific: large model / simulation outputs
# ------------------------------------------------------------
results/raw/
results/large/
results/*.pkl
results/*.h5
*.bin

# ------------------------------------------------------------
# EPANET runtime artefacts
# ------------------------------------------------------------
*.rpt
*.out
*.tmp
en2.log
# EPANET / WNTR runtime trio written to repo root during run_sim()
/temp.*
# Same trio written to learning/ when running the supervisor's starter notebook
learning/temp.*

# ------------------------------------------------------------
# Literature PDFs
# Keep PDFs locally for reading, but don't version-control them.
# literature.md is the source of truth; PDFs are personal-use binaries.
# ------------------------------------------------------------
background/Literature/**/*.pdf

# ------------------------------------------------------------
# Thesis / LaTeX build artefacts
# ------------------------------------------------------------
thesis/*.aux
thesis/*.bbl
thesis/*.blg
thesis/*.fls
thesis/*.fdb_latexmk
thesis/*.log
thesis/*.out
thesis/*.toc
thesis/*.synctex.gz
thesis/_build/
thesis/build/

# ------------------------------------------------------------
# Scratch / temporary working files
# ------------------------------------------------------------
tmp/

# ------------------------------------------------------------
# Misc
# ------------------------------------------------------------
.env
.env.*
!.env.example
node_modules/

# ------------------------------------------------------------
# Kilo Code extension workspace (npm deps, agent config)
# ------------------------------------------------------------
.kilo/

# ------------------------------------------------------------
# EPANET input written to Net3/ during run_sim() (runtime artefact)
# ------------------------------------------------------------
Net3/temp.*

# ------------------------------------------------------------
# Large regenerable likelihood grids over the prior box, and the sidecars recording which
# configuration built them. Rebuild via step7b / step7c; they are machine-local intermediates.
# ------------------------------------------------------------
Net3/baseline_cache/step7c_resid_grid.npy
Net3/baseline_cache/step7b_rmse_grid.npy
Net3/baseline_cache/*.npy.key.json
# Prediction libraries reused by displaced-prior / k_b sweeps (rebuild via the step that writes them).
Net3/baseline_cache/step*_preds_*.npy

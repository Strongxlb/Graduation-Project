    "risk_band_mapping": {
      "not applicable": "score = 0",
      "low": "1 <= score <= 3",
      "medium": "4 <= score <= 6",
      "high": "7 <= score <= 9",
      "very high": "score >= 10"
    },
    "sampling_priority": "consequence SCORE (0-3, not raw demand) x P_min(1 - P_min), normalised by its maximum; forced to 0 at zero-demand nodes. This ranks where MEASUREMENT would reduce uncertainty most, so a node with P_min = 1 scores 0: it is confidently at risk, not low priority. Intervention priority is the separate risk_score column; the two must not be merged."
